---
import Layout from '../layouts/Layout.astro';

const pageTitle = '404 - 页面未找到';
const pageDescription = '抱歉，您请求的页面不存在或已被重构移除。建议返回首页或查阅 2026 机场推荐与客户端配置教程。';
---

<Layout title={pageTitle} description={pageDescription} robots="noindex, follow">
  <div class="mx-auto max-w-3xl px-6 py-20 font-mono text-center">
    <!-- 404 Code Badge -->
    <div class="inline-flex items-center gap-2 rounded-full border border-rose-500/40 bg-rose-950/20 px-4 py-1.5 text-xs font-bold text-rose-400 mb-6">
      <span class="size-2 rounded-full bg-rose-500 animate-ping"></span>
      <span>HTTP 404 NOT FOUND · 链路断开</span>
    </div>

    <h1 class="text-5xl sm:text-7xl font-extrabold tracking-tight text-fg mb-4">
      404
    </h1>

    <p class="text-base sm:text-lg text-muted max-w-xl mx-auto mb-8 leading-relaxed">
      抱歉，您所访问的节点路径未被收录或已发生迁移重构。请通过下方核心导航寻找您需要的评测与教程资源。
    </p>

    <!-- Terminal error box -->
    <div class="mx-auto max-w-lg rounded-lg border border-hairline bg-[#0D1117] p-5 text-left text-xs mb-8 shadow-xl">
      <div class="flex items-center justify-between border-b border-hairline/60 pb-2 mb-3 text-muted">
        <span>terminal://trace-route-error</span>
        <span class="text-rose-400">STATUS: DROPPED</span>
      </div>
      <div class="space-y-1 font-mono text-muted/80">
        <div>$ traceroute target_uri</div>
        <div>1  gateway.local (lan.router)  0.42 ms</div>
        <div>2  edge.isp.backbone (edge.node)  1.85 ms</div>
        <div class="text-rose-400">3  * * * Request timed out [Error 404: Target Not Found]</div>
      </div>
    </div>

    <!-- Quick Navigation Links -->
    <div class="flex flex-wrap items-center justify-center gap-3">
      <a
        href="/"
        class="rounded bg-accent px-6 py-2.5 text-xs font-bold text-on-accent transition-opacity hover:opacity-90 shadow-md"
      >
        返回平台首页 →
      </a>
      <a
        href="/jichang"
        class="rounded border border-outline bg-base px-5 py-2.5 text-xs font-medium text-fg hover:border-accent hover:text-accent transition-colors"
      >
        查看机场推荐榜
      </a>
      <a
        href="/brands"
        class="rounded border border-outline bg-base px-5 py-2.5 text-xs font-medium text-fg hover:border-accent hover:text-accent transition-colors"
      >
        品牌评测全库
      </a>
      <a
        href="/tutorial"
        class="rounded border border-outline bg-base px-5 py-2.5 text-xs font-medium text-fg hover:border-accent hover:text-accent transition-colors"
      >
        客户端使用教程
      </a>
    </div>
  </div>
</Layout>
