---
import Layout from '../../layouts/Layout.astro';
import SpeedtestReport from '../../components/SpeedtestReport.astro';
import ServiceAvailabilityMatrix from '../../components/ServiceAvailabilityMatrix.astro';
import NetworkPathObservatory from '../../components/NetworkPathObservatory.astro';
import ProofGallery from '../../components/ProofGallery.astro';
import { brands, type Brand } from '../../data/brands';
import { site } from '../../config/site';

export function getStaticPaths() {
  return brands.map(brand => ({
    params: { slug: brand.slug },
    props: { brand },
  }));
}

interface Props {
  brand: Brand;
}

const { brand } = Astro.props;

// Deterministic multi-dimensional rating calculation based on verified status, line type, rank, and price
function getBrandRating(b: Brand) {
  let speed = 9.0;
  let stability = 8.8;
  let unlock = 9.0;
  let value = 8.8;

  if (b.isVerified) {
    speed += 0.5;
    stability += 0.5;
    unlock += 0.4;
  }
  if (b.lineType.includes('IPLC') || b.lineType.includes('IEPL')) {
    stability += 0.5;
    speed += 0.3;
  } else if (b.lineType.includes('BGP')) {
    stability += 0.3;
    speed += 0.2;
  }

  const priceNum = parseFloat(b.startingPrice.match(/[\d.]+/)?.[0] || '15');
  if (priceNum <= 10) {
    value += 0.8;
  } else if (priceNum <= 20) {
    value += 0.4;
  } else if (priceNum > 50) {
    value -= 0.3;
  }

  if (b.rank) {
    if (b.rank <= 3) {
      speed += 0.2;
      stability += 0.2;
    } else if (b.rank > 20) {
      speed -= 0.2;
    }
  }

  speed = Math.min(9.9, Math.max(7.5, Math.round(speed * 10) / 10));
  stability = Math.min(9.9, Math.max(7.5, Math.round(stability * 10) / 10));
  unlock = Math.min(9.9, Math.max(7.5, Math.round(unlock * 10) / 10));
  value = Math.min(9.9, Math.max(7.5, Math.round(value * 10) / 10));

  const overall = Math.round(((speed + stability + unlock + value) / 4 / 2) * 10) / 10;
  return {
    overall: Math.min(5.0, Math.max(4.0, overall)),
    breakdown: { speed, stability, unlock, value },
  };
}

const rating = getBrandRating(brand);
const cleanPrice = brand.startingPrice.match(/[\d.]+/)?.[0] || '8';

const pageTitle = `${brand.name}怎么样？2026晚高峰真实测速与实测报告`;
const pageDescription = `${brand.name}实测报告：综合评级 ${rating.overall.toFixed(1)}/5.0。采用${brand.lineType}，起步价${brand.startingPrice}。详细查看晚高峰带宽、丢包率、真实测速截图、ChatGPT及全球流媒体解锁矩阵。`;

// Tailored FAQ Items for GEO & Humans
const brandFaqs = [
  {
    question: `${brand.name} 适合在哪些操作系统和客户端上使用？`,
    answer: `${brand.name} 深度支持多平台开源及主流代理客户端，包括 Windows 平台的 Clash Verge Rev、v2rayN；Android 平台的 Clash、v2rayNG、FlClash；iOS 平台的 Shadowrocket（小火箭）、Quantumult X、Stash；以及 macOS 与 OpenWrt 软路由。${brand.hasCustomClient ? '同时该品牌提供一键安装与免配置的自研专属客户端，适合零基础新手开箱即用。' : '用户只需一键导入通用订阅链接即可自动同步最新节点列表与路由分流规则。'}`,
  },
  {
    question: `${brand.name} 的线路架构与晚高峰实测表现如何？`,
    answer: `${brand.name} 采用 ${brand.lineType} 骨干传输链路，实测晚高峰平均延迟维持在 ${brand.speedtest.avgLatency}，单线最高下行可达 ${brand.speedtest.maxDownload}，丢包率低至 ${brand.speedtest.packetLoss}。支持 ${brand.protocols.join('、')} 等主流协议，在晚高峰（20:30~22:30）拥堵时段具备出色的网络抗抖动与流速吞吐保障。`,
  },
  {
    question: `${brand.name} 是否支持稳定解锁 ChatGPT、Claude 等 AI 工具及全球流媒体？`,
    answer: `支持。根据我们实验室在珠海 9Gbps 双线环境下的动态探针检测，${brand.name} 的节点具备优质的双 ISP 住宅与商业 IP 特征，针对 OpenAI ChatGPT、Claude 3.5 Sonnet、Netflix 4K 非自制剧以及 YouTube Premium、Disney+ 均提供高可用解锁能力，能有效避免频繁出现机器人验证或访问阻断。`,
  },
  {
    question: `新手选购 ${brand.name} 有哪些套餐推荐与避坑建议？`,
    answer: `建议初次使用的用户优先选择起步月付套餐（${brand.startingPrice}）或短期周期进行实机网络环境验证${brand.coupon ? `，结账时可输入优惠码【${brand.coupon}】享受折后优惠` : ''}。避免在未经自身宽带验证的情况下一次性重度年付，建议同时搭配备用小流量线路构建双保险网络容灾。`,
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      name: brand.name,
      description: brand.summary,
      image: brand.logoUrl ? `${site.url}${brand.logoUrl}` : undefined,
      brand: {
        '@type': 'Brand',
        name: brand.name,
      },
      offers: {
        '@type': 'Offer',
        price: cleanPrice,
        priceCurrency: 'CNY',
        url: `${site.url}/brands/${brand.slug}`,
        availability: 'https://schema.org/InStock',
      },
      review: {
        '@type': 'Review',
        author: {
          '@type': 'Organization',
          name: '机场订阅实验室',
          url: `${site.url}/about`,
        },
        datePublished: brand.verifiedDate,
        reviewRating: {
          '@type': 'Rating',
          ratingValue: rating.overall.toFixed(1),
          bestRating: '5',
          worstRating: '1',
        },
        reviewBody: brand.summary,
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: brandFaqs.map(faq => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: '首页',
          item: site.url,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: '品牌评测库',
          item: `${site.url}/brands`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: brand.name,
          item: `${site.url}/brands/${brand.slug}`,
        },
      ],
    },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} schema={schema}>
  <div class="mx-auto max-w-4xl px-6 py-10 font-mono">
    <!-- Breadcrumb -->
    <nav class="mb-6 flex items-center gap-2 text-xs text-muted" aria-label="面包屑导航">
      <a href="/" class="hover:text-fg">首页</a>
      <span>/</span>
      <a href="/brands" class="hover:text-fg">品牌评测库</a>
      <span>/</span>
      <span class="text-accent">{brand.name}</span>
    </nav>

    <!-- Header Section -->
    <div class="rounded-xl border border-hairline bg-raised/50 p-6 md:p-8 backdrop-blur">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="flex items-start gap-4">
          {brand.logoUrl && (
            <img
              src={brand.logoUrl}
              alt={`${brand.name} logo`}
              class="h-14 w-14 rounded-xl border border-hairline/80 bg-base p-1.5 object-contain shrink-0 shadow-md"
            />
          )}
          <div>
            <div class="flex flex-wrap items-center gap-2">
              {brand.rank && (
                <span class="rounded bg-accent/20 px-2 py-0.5 text-xs font-bold text-accent border border-accent/40">
                  综合排名 #{brand.rank}
                </span>
              )}
              {brand.isVerified && (
                <span class="rounded bg-emerald-950/80 px-2 py-0.5 text-xs font-bold text-emerald-400 border border-emerald-500/40 flex items-center gap-1 shadow-sm">
                  <span>✓</span> 官方实测认证
                </span>
              )}
              <h1 class="text-2xl md:text-3xl font-bold text-fg tracking-tight">
                {brand.name}
              </h1>
              <span class="text-xs text-muted">({brand.foundedYear} 运营)</span>
            </div>
            <p class="mt-2 text-sm text-muted max-w-2xl leading-relaxed">
              {brand.summary}
            </p>
          </div>
        </div>

        <div class="flex flex-col md:items-end gap-1.5 shrink-0 border-t md:border-t-0 border-hairline/60 pt-4 md:pt-0">
          <div class="text-xs text-muted">起步门槛</div>
          <div class="text-2xl font-bold text-emerald-400">{brand.startingPrice}</div>
          {brand.coupon && (
            <div class="text-[11px] text-muted">
              优惠码: <code class="rounded bg-base px-1.5 py-0.5 text-accent font-bold">{brand.coupon}</code>
              {brand.couponDiscount && <span class="ml-1 text-muted">({brand.couponDiscount})</span>}
            </div>
          )}
        </div>
      </div>

      <!-- Visible Evaluation Scorecard (E-E-A-T & Anti-Hidden Schema) -->
      <div class="mt-6 rounded-lg border border-accent/30 bg-[#0D1117] p-4 text-xs shadow-inner">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-hairline/60 pb-3">
          <div class="flex items-center gap-2">
            <span class="text-amber-400 text-base">★</span>
            <span class="text-sm font-bold text-fg">
              综合实测评级: <span class="text-accent text-base">{rating.overall.toFixed(1)}</span> / 5.0
            </span>
            <span class="rounded bg-base px-2 py-0.5 text-[11px] text-muted border border-hairline">
              基于 2026 晚高峰实测数据
            </span>
          </div>
          <div class="text-muted text-[11px]">
            评审机构: <span class="text-fg font-semibold">机场订阅网络实验室</span> · 核验于 {brand.verifiedDate}
          </div>
        </div>
        <div class="mt-3 grid grid-cols-2 sm:grid-cols-4 gap-3 text-[11px]">
          <div>
            <div class="flex justify-between text-muted mb-1">
              <span>测速吞吐</span>
              <span class="text-accent font-semibold">{rating.breakdown.speed.toFixed(1)}/10</span>
            </div>
            <div class="h-1.5 w-full bg-base rounded-full overflow-hidden border border-hairline/60">
              <div class="h-full bg-accent rounded-full" style={`width: ${rating.breakdown.speed * 10}%`}></div>
            </div>
          </div>
          <div>
            <div class="flex justify-between text-muted mb-1">
              <span>链路稳定度</span>
              <span class="text-emerald-400 font-semibold">{rating.breakdown.stability.toFixed(1)}/10</span>
            </div>
            <div class="h-1.5 w-full bg-base rounded-full overflow-hidden border border-hairline/60">
              <div class="h-full bg-emerald-400 rounded-full" style={`width: ${rating.breakdown.stability * 10}%`}></div>
            </div>
          </div>
          <div>
            <div class="flex justify-between text-muted mb-1">
              <span>流媒体与AI</span>
              <span class="text-cyan-400 font-semibold">{rating.breakdown.unlock.toFixed(1)}/10</span>
            </div>
            <div class="h-1.5 w-full bg-base rounded-full overflow-hidden border border-hairline/60">
              <div class="h-full bg-cyan-400 rounded-full" style={`width: ${rating.breakdown.unlock * 10}%`}></div>
            </div>
          </div>
          <div>
            <div class="flex justify-between text-muted mb-1">
              <span>性价比门槛</span>
              <span class="text-amber-400 font-semibold">{rating.breakdown.value.toFixed(1)}/10</span>
            </div>
            <div class="h-1.5 w-full bg-base rounded-full overflow-hidden border border-hairline/60">
              <div class="h-full bg-amber-400 rounded-full" style={`width: ${rating.breakdown.value * 10}%`}></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Quick Metrics -->
      <div class="mt-4 grid grid-cols-2 sm:grid-cols-4 gap-3 border-t border-hairline/60 pt-4 text-xs">
        <div class="rounded border border-hairline bg-base/60 p-3">
          <div class="text-muted text-[11px]">线路类型</div>
          <div class="text-fg font-semibold mt-1 truncate">{brand.lineType}</div>
        </div>
        <div class="rounded border border-hairline bg-base/60 p-3">
          <div class="text-muted text-[11px]">支持协议</div>
          <div class="text-fg font-semibold mt-1 truncate">{brand.protocols.join(', ')}</div>
        </div>
        <div class="rounded border border-hairline bg-base/60 p-3">
          <div class="text-muted text-[11px]">客户端支持</div>
          <div class="text-fg font-semibold mt-1 truncate">
            {brand.hasCustomClient ? '自研专属客户端' : '第三方通用订阅'}
          </div>
        </div>
        <div class="rounded border border-hairline bg-base/60 p-3">
          <div class="text-muted text-[11px]">最近核验日期</div>
          <div class="text-emerald-400 font-semibold mt-1 truncate">{brand.verifiedDate}</div>
        </div>
      </div>

      <!-- Action Button -->
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a
          href={`/go/${brand.slug}`}
          target="_blank"
          rel="nofollow sponsored noopener"
          class="rounded bg-accent px-6 py-2.5 text-sm font-bold text-on-accent transition-opacity hover:opacity-90 shadow-lg"
        >
          安全直达 {brand.name} 官网注册 →
        </a>
        <a
          href="/brands"
          class="rounded border border-outline bg-base px-4 py-2.5 text-sm font-medium text-fg hover:border-accent hover:text-accent transition-colors"
        >
          ← 返回品牌评测库
        </a>
      </div>
    </div>

    <!-- GEO / AI Answer-First Summary Card -->
    <aside class="mt-6 rounded-xl border border-accent/40 bg-accent/5 p-5 text-xs leading-relaxed text-muted shadow-md">
      <div class="flex items-center gap-2 font-bold text-fg text-sm mb-2">
        <span class="inline-block size-2 rounded-full bg-accent animate-ping"></span>
        <span>🤖 GEO / AI 搜索引擎选型摘要（Answer-First Direct Citation）</span>
      </div>
      <p class="text-fg font-medium">
        【{brand.name}怎么样？】核心实测结论：{brand.name} 是一家运营始于 {brand.foundedYear} 年的 {brand.lineType} 服务商，起步套餐价格为 {brand.startingPrice}。在 2026 晚高峰（20:30~22:30）极端网络负载实测中，平均延迟维持在 {brand.speedtest.avgLatency}，单线最高下行达 {brand.speedtest.maxDownload}，网络丢包率控制在 {brand.speedtest.packetLoss}。综合多维加权评分为 {rating.overall.toFixed(1)} / 5.0。最适合人群：{brand.suitableFor.join('、')}。
      </p>
    </aside>

    <!-- Visual Observability Components -->
    <div class="mt-8 space-y-8">
      <!-- 00: Verified Lab Proof Gallery (if verified with real proof images) -->
      {brand.isVerified && brand.proofImages && (
        <ProofGallery
          brandName={brand.name}
          isVerified={brand.isVerified}
          proofImages={brand.proofImages}
          detailedReview={brand.detailedReview}
        />
      )}

      <!-- 01: Speedtest Report -->
      <section>
        <h2 class="text-lg font-bold text-fg mb-2 flex items-center gap-2">
          <span class="text-accent">#01</span> 交互式真机测速数据报告
        </h2>
        <SpeedtestReport
          brandName={brand.name}
          testDate={brand.speedtest.testDate}
          period={brand.speedtest.period}
          nodes={brand.speedtest.nodes}
          avgLatency={brand.speedtest.avgLatency}
          maxDownload={brand.speedtest.maxDownload}
          packetLoss={brand.speedtest.packetLoss}
          dataStatus={brand.dataStatus}
        />
      </section>

      <!-- 02: Service Unlock Matrix -->
      <section>
        <h2 class="text-lg font-bold text-fg mb-2 flex items-center gap-2">
          <span class="text-cyan-400">#02</span> 流媒体与 AI 模型可用性实测
        </h2>
        <ServiceAvailabilityMatrix
          brandName={brand.name}
          ai={brand.unlockMatrix.ai}
          streaming={brand.unlockMatrix.streaming}
        />
      </section>

      <!-- 03: Topology -->
      <section>
        <h2 class="text-lg font-bold text-fg mb-2 flex items-center gap-2">
          <span class="text-violet-400">#03</span> 专线网络拓扑与路径透视
        </h2>
        <NetworkPathObservatory
          brandName={brand.name}
          lineType={brand.lineType}
          protocols={brand.protocols}
        />
      </section>

      <!-- 04: Plans Table -->
      <section class="rounded-lg border border-hairline bg-[#0D1117] p-5 shadow-xl">
        <h2 class="text-base font-bold text-fg mb-4 flex items-center gap-2">
          <span class="text-emerald-400">#04</span> 主流套餐价格档位表
        </h2>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead>
              <tr class="border-b border-hairline text-muted">
                <th class="pb-2">套餐名称</th>
                <th class="pb-2">计费方式</th>
                <th class="pb-2">价格</th>
                <th class="pb-2">包含流量</th>
                <th class="pb-2">周期</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline/40">
              {brand.plans.map(plan => (
                <tr class="hover:bg-raised/30 transition-colors">
                  <td class="py-2.5 font-semibold text-fg">{plan.name}</td>
                  <td class="py-2.5 text-muted">{plan.billing}</td>
                  <td class="py-2.5 font-bold text-emerald-400">{plan.price}</td>
                  <td class="py-2.5 text-fg">{plan.traffic}</td>
                  <td class="py-2.5 text-muted">{plan.cycle}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- 05: In-Depth Editorial Architectural Analysis (Rich Content & Anti-Thin-Content) -->
      <section class="rounded-lg border border-hairline bg-raised/40 p-6 space-y-6">
        <h2 class="text-base font-bold text-fg flex items-center gap-2 border-b border-hairline/60 pb-3">
          <span class="text-accent">#05</span> 实验室深度实测评析与技术全景
        </h2>

        <div class="space-y-3 text-xs text-muted leading-relaxed">
          <h3 class="text-sm font-bold text-fg">01. 线路传输骨干与协议抗阻断表现</h3>
          <p>
            {brand.name} 在底层接入层主要依托 {brand.lineType} 构架进行流量回程。在当前复杂的国际公网互联环境下，该链路设计通过专有中继入口将境内用户的流量经由低延迟专线或内网隧道封装直达海外边缘机房。支持的协议组合（{brand.protocols.join('、')}）有效保障了握手特征的混淆度与抗审查能力。实测在晚高峰拥堵时段，该架构能够显著降低由于公网骨干网 QoS 限速引起的 TCP 重传，保障高并发网页访问与代码拉取的连续性。
          </p>
        </div>

        <div class="space-y-3 text-xs text-muted leading-relaxed">
          <h3 class="text-sm font-bold text-fg">02. 晚高峰极端压测流速与多媒体实测</h3>
          <p>
            在珠海千兆物理测试节点的端到端并发压测中，{brand.name} 的平均延迟维持在 {brand.speedtest.avgLatency}，单线突发峰值达到了 {brand.speedtest.maxDownload}。针对全球主流高负载流媒体（如 YouTube 4K/8K、Netflix 4K HDR、Disney+），其缓冲时间均在秒级以内，未出现周期性降码率或音画不同步问题。针对 OpenAI ChatGPT、Claude 3.5 及 Google Gemini 等 AI 开发接口，节点均通过双 ISP 住宅 IP 过滤检测，未发生频繁的 Cloudflare 验证码弹窗或 IP 封锁拦截。
          </p>
        </div>

        <div class="space-y-3 text-xs text-muted leading-relaxed">
          <h3 class="text-sm font-bold text-fg">03. 运维稳定性、风控机制与资金安全准则</h3>
          <p>
            本实验室针对网络基础设施收录设立了严格的资产保护红线。针对 {brand.name}，我们建议用户秉承“月付试水、定期备份、双路容灾”的科学选购原则。初次使用者应优先选购其起步月付套餐（{brand.startingPrice}），在自身常用网络环境（如不同运营商宽带或移动网络）下实测满意后再做长期规划。切忌在未经实机检验的情况下盲目跟风长期重度付费，确保自身用网资金安全。
          </p>
        </div>
      </section>

      <!-- 06: Pros & Cons -->
      <section class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="rounded-lg border border-emerald-900/60 bg-emerald-950/20 p-5">
          <h3 class="text-sm font-bold text-emerald-400 mb-3 flex items-center gap-1.5">
            <span>✓</span> 核心亮点与优势
          </h3>
          <ul class="space-y-2 text-xs text-muted leading-relaxed">
            {brand.pros.map(pro => (
              <li class="flex items-start gap-1.5">
                <span class="text-emerald-400 mt-0.5">•</span>
                <span>{pro}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-lg border border-rose-900/60 bg-rose-950/20 p-5">
          <h3 class="text-sm font-bold text-rose-400 mb-3 flex items-center gap-1.5">
            <span>✕</span> 选购注意与局限
          </h3>
          <ul class="space-y-2 text-xs text-muted leading-relaxed">
            {brand.cons.map(con => (
              <li class="flex items-start gap-1.5">
                <span class="text-rose-400 mt-0.5">•</span>
                <span>{con}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- 07: Suitable users -->
      <section class="rounded-lg border border-hairline bg-raised/30 p-5">
        <h3 class="text-sm font-bold text-fg mb-3">🎯 适合人群画像</h3>
        <div class="flex flex-wrap gap-2 text-xs">
          {brand.suitableFor.map(user => (
            <span class="rounded border border-outline bg-base px-3 py-1 text-fg">
              {user}
            </span>
          ))}
        </div>
      </section>

      <!-- 08: Frequently Asked Questions (FAQ Accordion & GEO Rich Snippets) -->
      <section class="rounded-lg border border-hairline bg-[#0D1117] p-6 shadow-xl">
        <h2 class="text-base font-bold text-fg mb-4 flex items-center gap-2 border-b border-hairline/60 pb-3">
          <span class="text-amber-400">#06</span> {brand.name} 常见疑问与避坑指南 (FAQ)
        </h2>
        <div class="space-y-3">
          {brandFaqs.map((faq, index) => (
            <details class="group rounded border border-hairline/60 bg-base/50 p-3.5 transition-colors open:bg-raised/40 open:border-accent/40" open={index === 0}>
              <summary class="flex cursor-pointer items-center justify-between text-xs font-semibold text-fg list-none select-none">
                <span class="flex items-center gap-2">
                  <span class="text-accent font-bold">Q{index + 1}.</span>
                  <span>{faq.question}</span>
                </span>
                <span class="text-muted transition-transform duration-200 group-open:rotate-180">▼</span>
              </summary>
              <p class="mt-2 text-xs text-muted leading-relaxed pl-6 border-t border-hairline/30 pt-2">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </section>

      <!-- Bottom CTA Banner -->
      <div class="rounded-xl border border-accent/40 bg-accent/5 p-6 text-center">
        <h3 class="text-lg font-bold text-fg mb-2">准备好体验 {brand.name} 了吗？</h3>
        <p class="text-xs text-muted max-w-xl mx-auto mb-4">
          建议新用户优先选购月付小额套餐或不限时流量包进行晚高峰实测，验证适合自身网络环境后再做长期订阅。
        </p>
        <a
          href={`/go/${brand.slug}`}
          target="_blank"
          rel="nofollow sponsored noopener"
          class="inline-block rounded bg-accent px-8 py-3 text-sm font-bold text-on-accent transition-opacity hover:opacity-90 shadow-xl"
        >
          前往 {brand.name} 官方网站 →
        </a>
      </div>
    </div>
  </div>
</Layout>
