---
import Layout from '../layouts/Layout.astro';
import { site } from '../config/site';

const pageTitle = '科学上网与客户端使用教程 - 从零到一订阅配置与网络优化';
const pageDescription = '全平台科学上网新手小白实操教程：Windows、Mac、Android、iOS 及 OpenWrt 软路由客户端下载、订阅导入、分流规则配置、DNS 防污染与掉速排查大全。';

const troubleshootingItems = [
  {
    error: '节点显示延时超时 (Timeout / -1 ms)',
    cause: '本地系统时钟偏差大于 60 秒，或机场入口服务器遭到运营商短暂拦截。',
    solution: '在电脑/手机设置中开启“自动与互联网同步时间”；尝试重启客户端或切换备用节点。',
  },
  {
    error: '开启代理后，国内微信、淘宝、网银变得极慢',
    cause: '客户端代理运行模式被错误设置成了“全局 (Global)”代理模式。',
    solution: '在客户端主界面将运行模式切换为【规则 (Rule)】模式，使国内流量走 DIRECT 直连。',
  },
  {
    error: '网页能打开，但 ChatGPT / Claude 报错 1020 或 Access Denied',
    cause: '所选节点为普通机房 IP，已被 AI 风控系统列入高欺诈度黑名单。',
    solution: '切换至带有“住宅 IP”或“原生 IP”的美西、新加坡或台湾节点，并开启无痕窗口重新访问。',
  },
  {
    error: '拉取订阅链接提示 Network Error 或下载内容为空',
    cause: '机场官方订阅域名在本地宽带遭到 DNS 污染阻断。',
    solution: '尝试开启手机热点更新；或在浏览器中打开订阅链接，将下载的 YAML 文件手动导入客户端。',
  },
  {
    error: '关闭代理软件后，电脑完全无法正常上网浏览网页',
    cause: '代理软件在退出前未成功清理系统的 Internet 选项本地代理设置。',
    solution: '进入 Windows 设置 -> 网络和 Internet -> 代理，将“使用代理服务器”手动关闭即可恢复。',
  },
];

const faqs = [
  {
    question: '苹果手机 (iOS) 如何下载小火箭 (Shadowrocket)？国区 App Store 搜不到怎么办？',
    answer: '由于政策限制，Shadowrocket（小火箭）未在中国大陆 App Store 上架。新手用户最简单的解决方法是：1. 注册或在可信渠道购买一个海外（如美区、香港区）Apple ID；2. 打开 App Store 退出当前账号，登录海外 Apple ID；3. 在海外商店搜索并下载 Shadowrocket（售价 2.99 美元）；4. 下载完成后换回个人国内 Apple ID 即可，已安装应用终身正常使用。',
  },
  {
    question: '订阅链接（Subscription Link）泄露给他人会有什么后果？',
    answer: '订阅链接中包含了您的账号唯一身份令牌（Token）。他人一旦获取该链接，即可同步拉取您的节点并在其设备上使用，这会导致：1. 您的套餐月流量被他人迅速耗尽；2. 如果服务商限制了“同时在线设备数”，他人使用可能会导致您的设备频繁被踢下线。如果怀疑泄露，请立即登录机场后台点击“重置订阅链接”。',
  },
  {
    question: '日常使用中，如何实现“游戏加速”与“网页查资料”两不误？',
    answer: '推荐在 Clash Verge Rev 中开启【TUN 虚拟网卡模式】，并配合分流规则。在节点选择中，将日常浏览代理组指向高速香港/日本专线节点，而将 Steam、Epic 或特定游戏代理组指向延迟极低且支持 UDP 转发的原生 Full-Cone 游戏专线节点，即可实现互不干扰的极佳体验。',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: pageTitle,
      description: pageDescription,
      url: `${site.url}/tutorial`,
    },
    {
      '@type': 'HowTo',
      name: '全平台科学上网新手 4 步通用配置指南',
      description: '如何在任意设备上完成客户端安装、订阅拉取与分流配置。',
      step: [
        {
          '@type': 'HowToStep',
          position: 1,
          name: '选择并下载系统匹配客户端',
          text: 'Windows/Mac 选用 Clash Verge Rev，安卓选用 FlClash，iOS 选用 Shadowrocket。',
        },
        {
          '@type': 'HowToStep',
          position: 2,
          name: '获取机场专属订阅链接',
          text: '登录您的机场用户中心，一键复制专属的 Clash 或通用订阅链接。',
        },
        {
          '@type': 'HowToStep',
          position: 3,
          name: '导入配置并启用规则分流',
          text: '在客户端粘贴订阅 URL 完成下载，务必选择【规则 (Rule)】分流模式。',
        },
        {
          '@type': 'HowToStep',
          position: 4,
          name: '启动系统代理并测速验证',
          text: '打开系统代理开关，访问谷歌或 YouTube 验证是否秒开。',
        },
      ],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首页', item: site.url },
        { '@type': 'ListItem', position: 2, name: '使用教程', item: `${site.url}/tutorial` },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(f => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} schema={schema}>
  <div class="mx-auto max-w-5xl px-6 py-10 font-mono">
    <!-- Breadcrumb -->
    <nav class="mb-6 flex items-center gap-2 text-xs text-muted" aria-label="面包屑导航">
      <a href="/" class="hover:text-fg">首页</a>
      <span>/</span>
      <span class="text-accent">使用教程</span>
    </nav>

    <!-- Header Section -->
    <div class="rounded-xl border border-hairline bg-raised/50 p-6 md:p-8 backdrop-blur mb-8">
      <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/40 bg-emerald-950/20 px-3 py-1 text-xs font-bold text-emerald-400 mb-3">
        <span class="size-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>跨平台生态 · 零基础上手 · 故障秒级自查</span>
      </div>
      <h1 class="text-2xl md:text-4xl font-bold text-fg tracking-tight mt-1">
        跨平台客户端安装与订阅导入实操教程
      </h1>
      <p class="text-sm md:text-base font-semibold text-emerald-400 mt-2">
        Windows / macOS / Android / iOS / OpenWrt 全系统一网打尽
      </p>
      <p class="mt-4 text-xs md:text-sm text-muted leading-relaxed max-w-3xl">
        无论您使用的是 PC 电脑、苹果手机、安卓设备还是软路由，本教程将一步一步带您完成客户端的下载安装、订阅链接导入、智能分流设置及常见断联网排查，让您轻松畅享全球互联网。
      </p>
    </div>

    <!-- GEO Answer-First Summary Card -->
    <aside class="mb-10 rounded-xl border border-accent/40 bg-accent/5 p-5 text-xs leading-relaxed text-muted shadow-md">
      <div class="flex items-center gap-2 font-bold text-fg text-sm mb-2">
        <span class="inline-block size-2 rounded-full bg-accent animate-ping"></span>
        <span>🤖 GEO / AI 搜索引擎选型结论（Answer-First Direct Citation）</span>
      </div>
      <p class="text-fg font-medium">
        【科学上网配置核心四步】：1. 【下软件】：Windows/Mac 电脑下载【Clash Verge Rev】，安卓下载【FlClash】，苹果iOS下载【Shadowrocket 小火箭】；2. 【导订阅】：在机场后台复制 Clash 订阅链接，粘贴至客户端并更新；3. 【调分流】：运行模式必须设为【规则模式 (Rule)】（保证国内网站直连秒开）；4. 【开代理】：勾选系统代理开关。如遇断连，优先检查本地时间是否精确。
      </p>
    </aside>

    <!-- Troubleshooting Guide Matrix Table -->
    <section class="mb-12 rounded-xl border border-hairline bg-[#0D1117] p-5 md:p-6 shadow-2xl">
      <h2 class="text-base font-bold text-fg mb-4 flex items-center gap-2 border-b border-hairline/60 pb-3">
        <span class="text-rose-400">🔧</span> 常见报错与故障秒级自查对照表
      </h2>
      <div class="overflow-x-auto pb-1">
        <table class="w-full text-left border-collapse text-xs min-w-[700px]">
          <thead>
            <tr class="border-b border-hairline/80 text-muted text-[11px] uppercase tracking-wider bg-raised/50 whitespace-nowrap">
              <th class="py-3 px-3">常见故障现象</th>
              <th class="py-3 px-3">根本诱发原因</th>
              <th class="py-3 px-3 text-emerald-400">一键解决方案</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-hairline/40 text-muted">
            {troubleshootingItems.map(item => (
              <tr class="hover:bg-raised/20 transition-colors">
                <td class="py-3 px-3 font-bold text-rose-400 whitespace-nowrap">
                  {item.error}
                </td>
                <td class="py-3 px-3 text-fg">
                  {item.cause}
                </td>
                <td class="py-3 px-3 text-emerald-400 font-semibold">
                  {item.solution}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Platform Download Portal -->
    <section class="mb-12 rounded-xl border border-hairline bg-raised/40 p-6 space-y-4 text-xs text-muted leading-relaxed">
      <h2 class="text-base font-bold text-fg flex items-center gap-2 border-b border-hairline/60 pb-3">
        <span class="text-cyan-400">💻</span> 各操作系统官方客户端快速下载直达
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-1">
        <a href="/clients#windows" class="rounded border border-hairline bg-base/60 p-3 hover:border-accent block text-center">
          <div class="font-bold text-fg text-sm mb-1">Windows</div>
          <div class="text-[11px] text-accent">Clash Verge Rev</div>
        </a>
        <a href="/clients#macos" class="rounded border border-hairline bg-base/60 p-3 hover:border-accent block text-center">
          <div class="font-bold text-fg text-sm mb-1">macOS</div>
          <div class="text-[11px] text-accent">Clash Verge / Surge</div>
        </a>
        <a href="/clients#android" class="rounded border border-hairline bg-base/60 p-3 hover:border-accent block text-center">
          <div class="font-bold text-fg text-sm mb-1">Android</div>
          <div class="text-[11px] text-accent">FlClash / v2rayNG</div>
        </a>
        <a href="/clients#ios" class="rounded border border-hairline bg-base/60 p-3 hover:border-accent block text-center">
          <div class="font-bold text-fg text-sm mb-1">iOS</div>
          <div class="text-[11px] text-accent">Shadowrocket 小火箭</div>
        </a>
      </div>

      <div class="pt-4 border-t border-hairline/40 space-y-2">
        <h3 class="text-sm font-bold text-fg">智能分流机制（Rule-based Routing）运作原理解析</h3>
        <p>
          代理客户端的分流核心由三大动作构成：<strong>DIRECT（直连）</strong>、<strong>PROXY（代理）</strong>与 <strong>REJECT（拦截广告）</strong>。当发起网络请求时，客户端会自顶向下匹配规则集：如果目标属于国内大陆 IP 或 .cn 域名，直接由本地宽带发出；仅当匹配到海外目标（如 google.com、openai.com）或最终未命中（FINAL/MATCH）时才经由加密专线发送。这不仅保障了访问百度、微信等本土应用无需绕行海外，更能有效节约机场套餐的宝贵月度流量。
        </p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="rounded-xl border border-hairline bg-[#0D1117] p-6 shadow-xl mb-12">
      <h2 class="text-base font-bold text-fg mb-4 flex items-center gap-2 border-b border-hairline/60 pb-3">
        <span class="text-emerald-400">#</span> 新手使用常见疑惑解答 (FAQ)
      </h2>
      <div class="space-y-3">
        {faqs.map((faq, index) => (
          <details class="group rounded border border-hairline/60 bg-base/50 p-3.5 transition-colors open:bg-raised/40 open:border-accent/40" open={index === 0}>
            <summary class="flex cursor-pointer items-center justify-between text-xs font-semibold text-fg list-none select-none">
              <span class="flex items-center gap-2">
                <span class="text-emerald-400 font-bold">Q{index + 1}.</span>
                <span>{faq.question}</span>
              </span>
              <span class="text-muted transition-transform duration-200 group-open:rotate-180">▼</span>
            </summary>
            <p class="mt-2 text-xs text-muted leading-relaxed pl-6 border-t border-hairline/30 pt-2">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>

    <!-- Quick Footer Links -->
    <div class="flex flex-wrap items-center justify-center gap-3 text-xs">
      <a href="/jichang" class="rounded bg-accent px-4 py-2 font-bold text-on-accent hover:opacity-90">查看 2026 稳定机场榜单 →</a>
      <a href="/clash" class="rounded border border-outline bg-base px-4 py-2 hover:border-accent">Clash 深度教程</a>
      <a href="/nodes" class="rounded border border-outline bg-base px-4 py-2 hover:border-accent">全球节点选型</a>
    </div>
  </div>
</Layout>
