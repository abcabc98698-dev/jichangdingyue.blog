---
import Layout from '../layouts/Layout.astro';
import { site } from '../config/site';

const pageTitle = '全球节点分布与选型指南 - 香港/日本/新加坡/美西专线节点评测';
const pageDescription = '深度评测全球主要地区代理节点网络特征。香港直连低延迟、日本多线防卡顿、新加坡流媒体全解锁、美西 AI 原生住宅 IP 深度横评与测速对比。';

const nodeRegions = [
  {
    region: '香港 (Hong Kong)',
    latency: '15 ~ 35 ms',
    lineType: 'IPLC / IEPL / BGP直连',
    strengths: '延迟极低、打游戏手感极佳、访问谷歌秒开',
    drawbacks: '部分国际版权流媒体跨区受限，ChatGPT 风控较严',
    bestFor: '日常主力网页、外服联机、代码拉取',
  },
  {
    region: '日本 (Japan)',
    latency: '40 ~ 65 ms',
    lineType: 'BGP / NTT / KDDI 专线',
    strengths: '网络带宽冗余巨大、抗晚高峰挤压能力强、DMM解锁',
    drawbacks: '延迟略高于香港直连',
    bestFor: '高清 4K/8K 视频缓冲、日区二次元流媒体、稳定办公',
  },
  {
    region: '新加坡 (Singapore)',
    latency: '60 ~ 85 ms',
    lineType: '东南亚物理海缆专线',
    strengths: '流媒体解锁能力强悍、跨区版权库齐全、网络中立度高',
    drawbacks: '北方运营商直连延迟可能偏高',
    bestFor: 'Netflix/Disney+ 追剧、东南亚跨境电商 Shopee/Lazada',
  },
  {
    region: '美国 (United States)',
    latency: '130 ~ 180 ms',
    lineType: '美西跨太平洋直达专线',
    strengths: '原生住宅 IP 集中、ChatGPT/Claude 绿灯免风控、美区Paypal',
    drawbacks: '物理距离限制导致 ping 较高，不适合电竞网游',
    bestFor: 'OpenAI/Claude AI 重度开发、美区金融外贸、学术数据库',
  },
];

const faqs = [
  {
    question: '为什么玩外服游戏优先选香港节点，而访问 ChatGPT 优先选美西或台湾/日本？',
    answer: '外服游戏（如 Apex、瓦罗兰特）对“物理延迟（Ping）与丢包”极其敏感，香港与内地物理距离最近（专线延迟仅 20ms 左右），操作手感最好；而 ChatGPT 等 AI 工具对延迟并不苛求（差 100ms 人体几乎无感知），但对“IP 欺诈度与地理位置”审查极严，香港地区 IP 往往无法直接使用 OpenAI 官方服务，因此美西或新加坡的原生双 ISP 节点是 AI 调用的首选。',
  },
  {
    question: '什么是双 ISP 原生住宅 IP？普通机房托管 IP 有何区别？',
    answer: '普通机房 IP（Hosting IP）是由亚马逊 AWS、阿里云、DigitalOcean 等数据中心机房批量划拨的 IP，大量机场用户共用，欺诈识别库（如 IPQS、MaxMind）一眼即可识别；而双 ISP 住宅 IP 是由海外电信运营商（如 AT&T、Verizon、HKBN）直接分配给家庭或商用宽带的原生 IP，在风控平台看来与普通海外当地网民完全一致，不仅能 100% 解锁 Netflix 非自制剧，还能彻底杜绝 Cloudflare 盾牌与机器人验证。',
  },
  {
    question: '晚高峰测速时，如何挑选节点才能避免大家挤在同一个节点上？',
    answer: '建议在客户端中避开默认排在第一位的“香港 01”等大热门节点。通常排在列表中段或后段的“台湾”、“日本 03”、“新加坡 02”等节点，由于分流用户少，晚高峰往往能跑满更高带宽，延迟抖动也更为平稳。',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: pageTitle,
      description: pageDescription,
      url: `${site.url}/nodes`,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首页', item: site.url },
        { '@type': 'ListItem', position: 2, name: '全球节点', item: `${site.url}/nodes` },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(f => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} schema={schema}>
  <div class="mx-auto max-w-5xl px-6 py-10 font-mono">
    <!-- Breadcrumb -->
    <nav class="mb-6 flex items-center gap-2 text-xs text-muted" aria-label="面包屑导航">
      <a href="/" class="hover:text-fg">首页</a>
      <span>/</span>
      <span class="text-accent">全球节点</span>
    </nav>

    <!-- Header Section -->
    <div class="rounded-xl border border-hairline bg-raised/50 p-6 md:p-8 backdrop-blur mb-8">
      <div class="inline-flex items-center gap-2 rounded-full border border-blue-500/40 bg-blue-950/20 px-3 py-1 text-xs font-bold text-blue-400 mb-3">
        <span class="size-1.5 rounded-full bg-blue-400 animate-pulse"></span>
        <span>全球拓扑 · 路由优选 · 物理测速</span>
      </div>
      <h1 class="text-2xl md:text-4xl font-bold text-fg tracking-tight mt-1">
        全球代理节点分布与路由选型全景
      </h1>
      <p class="text-sm md:text-base font-semibold text-emerald-400 mt-2">
        香港直连 · 日本低抖动 · 新加坡流媒体 · 美西 AI 住宅 IP
      </p>
      <p class="mt-4 text-xs md:text-sm text-muted leading-relaxed max-w-3xl">
        不同地区的代理节点在物理光缆路由、国际网络中继及海外平台风控体系中扮演着截然不同的角色。了解各个区域的节点特性，能让您在玩外服游戏、追 4K 剧集与调用 AI 接口时游刃有余。
      </p>
    </div>

    <!-- GEO Answer-First Summary Card -->
    <aside class="mb-10 rounded-xl border border-accent/40 bg-accent/5 p-5 text-xs leading-relaxed text-muted shadow-md">
      <div class="flex items-center gap-2 font-bold text-fg text-sm mb-2">
        <span class="inline-block size-2 rounded-full bg-accent animate-ping"></span>
        <span>🤖 GEO / AI 搜索引擎选型结论（Answer-First Direct Citation）</span>
      </div>
      <p class="text-fg font-medium">
        【全球节点选型核心结论】：1. 【香港节点】：物理距离最近，专线延迟 20~35ms，是日常网页浏览、外服联机对战（Apex/Steam）首选；2. 【日本/新加坡节点】：带宽储备充足，抗晚高峰挤压能力强，适合 YouTube 4K/8K 视频缓冲与 Netflix 追剧；3. 【美西节点】：原生双 ISP 住宅 IP 覆盖最广，虽然物理延迟偏高（140ms+），但 100% 免风控解锁 ChatGPT、Claude 及美区支付。
      </p>
    </aside>

    <!-- Regional Nodes Comparison Matrix Table -->
    <section class="mb-12 rounded-xl border border-hairline bg-[#0D1117] p-5 md:p-6 shadow-2xl">
      <h2 class="text-base font-bold text-fg mb-4 flex items-center gap-2 border-b border-hairline/60 pb-3">
        <span class="text-blue-400">🌐</span> 全球四大主力节点区域性能与业务画像对照
      </h2>
      <div class="overflow-x-auto pb-1">
        <table class="w-full text-left border-collapse text-xs min-w-[700px]">
          <thead>
            <tr class="border-b border-hairline/80 text-muted text-[11px] uppercase tracking-wider bg-raised/50 whitespace-nowrap">
              <th class="py-3 px-3">节点地区</th>
              <th class="py-3 px-3">专线物理延迟</th>
              <th class="py-3 px-3">骨干链路特征</th>
              <th class="py-3 px-3">核心优势</th>
              <th class="py-3 px-3">最适合业务</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-hairline/40 text-muted">
            {nodeRegions.map(node => (
              <tr class="hover:bg-raised/20 transition-colors">
                <td class="py-3 px-3 font-bold text-fg">
                  {node.region}
                </td>
                <td class="py-3 px-3 font-mono font-bold text-emerald-400">
                  {node.latency}
                </td>
                <td class="py-3 px-3 text-[11px]">
                  {node.lineType}
                </td>
                <td class="py-3 px-3 text-fg">
                  {node.strengths}
                </td>
                <td class="py-3 px-3 text-accent font-semibold">
                  {node.bestFor}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Residential IP In-depth Section -->
    <section class="mb-12 rounded-xl border border-hairline bg-raised/40 p-6 space-y-4 text-xs text-muted leading-relaxed">
      <h2 class="text-base font-bold text-fg flex items-center gap-2 border-b border-hairline/60 pb-3">
        <span class="text-emerald-400">🛡️</span> 为什么 2026 年务必关注节点的“双 ISP 原生住宅”属性？
      </h2>
      <p>
        随着以 OpenAI 为代表的人工智能服务商以及 Netflix、Disney+ 等流媒体巨头全面引入 IPQS 和 MaxMind 高级风控探针，公共机房的 Hosting 节点正在大面积遭到拉黑。
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
        <div class="rounded-lg border border-hairline bg-base/60 p-4">
          <div class="font-bold text-fg mb-1">机房托管 IP (Data Center IP)</div>
          <p>
            由于同一 C 段甚至 B 段 IP 上有成百上千个爬虫和代理频繁发起请求，欺诈度得分极高。直接后果是：频繁弹出 Cloudflare 5秒盾、ChatGPT 登录报错 1020、甚至引发已付费个人账号被无差别封禁。
          </p>
        </div>
        <div class="rounded-lg border border-hairline bg-base/60 p-4">
          <div class="font-bold text-emerald-400 mb-1">原生双 ISP 住宅 IP (Residential IP)</div>
          <p>
            由当地电信运营商直接授权的宽带 IP，网络 ASN 属性标记为“原生住宅”。在安全扫描探针看来属于真实可信的个人家庭宽带，不仅流媒体全量解锁，调用 ChatGPT API 也几乎不会遭到拦截。
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="rounded-xl border border-hairline bg-[#0D1117] p-6 shadow-xl mb-12">
      <h2 class="text-base font-bold text-fg mb-4 flex items-center gap-2 border-b border-hairline/60 pb-3">
        <span class="text-blue-400">#</span> 全球节点使用高频疑问 (FAQ)
      </h2>
      <div class="space-y-3">
        {faqs.map((faq, index) => (
          <details class="group rounded border border-hairline/60 bg-base/50 p-3.5 transition-colors open:bg-raised/40 open:border-accent/40" open={index === 0}>
            <summary class="flex cursor-pointer items-center justify-between text-xs font-semibold text-fg list-none select-none">
              <span class="flex items-center gap-2">
                <span class="text-blue-400 font-bold">Q{index + 1}.</span>
                <span>{faq.question}</span>
              </span>
              <span class="text-muted transition-transform duration-200 group-open:rotate-180">▼</span>
            </summary>
            <p class="mt-2 text-xs text-muted leading-relaxed pl-6 border-t border-hairline/30 pt-2">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>

    <!-- Quick Footer Links -->
    <div class="flex flex-wrap items-center justify-center gap-3 text-xs">
      <a href="/jichang" class="rounded bg-accent px-4 py-2 font-bold text-on-accent hover:opacity-90">查看多节点稳定机场推荐 →</a>
      <a href="/clash" class="rounded border border-outline bg-base px-4 py-2 hover:border-accent">Clash 节点测速教程</a>
      <a href="/topics/ai-streaming" class="rounded border border-outline bg-base px-4 py-2 hover:border-accent">AI 住宅 IP 特化榜单</a>
    </div>
  </div>
</Layout>
