---
import '@fontsource-variable/inter';
import '@fontsource-variable/newsreader';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { Icon } from 'astro-icon/components';
import { site } from '../config/site';
import { getI18n } from '../i18n/context';
import { htmlLang } from '../i18n/locales';
import { ui, type UiKey } from '../i18n/ui';
import { cssVariables } from '../lib/palette';
import { pageMetadata } from '../lib/seo';
import { isActive } from '../lib/site';
import { asset } from '../lib/urls';
import { getCtas } from '../lib/ctas';

interface Props {
  title?: string;
  description?: string;
  schema?: Record<string, unknown>;
  robots?: string;
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    tags?: string[];
  };
}

const { locale, t, path } = getI18n(Astro.currentLocale);
const {
  title,
  description = site.hero[locale]?.description || site.name,
  schema,
  robots,
  article,
} = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} - 2026 稳定机场推荐与网络节点实测平台`;
const pathname = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const ctas = getCtas(locale, base);
const home = path('/');

function navigationLabel(key: string): string {
  if (key in ui['zh-CN']) return t(key as UiKey);
  return key;
}

const block = (vars: Record<string, string>) =>
  Object.entries(vars)
    .map(([k, v]) => `${k}:${v}`)
    .join(';');
// Noir is the default; Paper is an explicit choice, remembered per visitor.
const themeCss =
  `:root{${block(cssVariables('dark'))};color-scheme:dark}` +
  `:root[data-theme="light"]{${block(cssVariables('light'))};color-scheme:light}`;

const navLink = (active: boolean) => [
  'border-b pb-1 font-mono text-xs tracking-wider uppercase transition-colors',
  active ? 'border-accent text-accent font-semibold' : 'border-transparent text-muted hover:text-fg',
];
const nav = site.nav.map(item => {
  const href = path(item.href);
  return { href, label: navigationLabel(item.key), active: isActive(href, pathname, home) };
});
const meta = pageMetadata(site.url, base, pathname, pageTitle, description);
---

<!doctype html>
<html lang={htmlLang(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="robots" content={robots || "index, follow, max-image-preview:large, max-snippet:-1"} />
    <link rel="canonical" href={meta.canonical} />
    <link rel="icon" href={asset('/favicon.svg', base)} type="image/svg+xml" />
    <link rel="alternate" hreflang="zh-CN" href={meta.canonical} />

    {/* Search Engine Webmaster Verifications (Google, Bing, Shenma, Baidu) */}
    {site.verification?.google && <meta name="google-site-verification" content={site.verification.google} />}
    {site.verification?.bing && <meta name="msvalidate.01" content={site.verification.bing} />}
    {site.verification?.shenma && <meta name="shenma-site-verification" content={site.verification.shenma} />}
    {site.verification?.baidu && <meta name="baidu-site-verification" content={site.verification.baidu} />}

    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={meta.canonical} />
    <meta property="og:image" content={meta.image} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.name} />

    {article?.publishedTime && <meta property="article:published_time" content={article.publishedTime} />}
    {article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
    {article?.author && <meta property="article:author" content={article.author} />}
    {article?.tags?.map((tag: string) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={meta.image} />
    {schema && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    )}
    <style is:inline set:html={themeCss} />
    <script is:inline>
      try {
        if (localStorage.getItem('tn-theme') === 'light') document.documentElement.dataset.theme = 'light';
      } catch {}
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-base text-fg">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded focus:bg-accent focus:px-3 focus:py-2 focus:text-on-accent"
    >
      {t('a11y.skip')}
    </a>

    <header class="sticky top-0 z-50 border-b border-hairline bg-base/95 backdrop-blur-md">
      <div class="mx-auto flex h-14 max-w-5xl items-center justify-between gap-4 px-6">
        <a
          href={home}
          class="flex items-center gap-1.5 font-mono text-sm tracking-tight text-fg font-bold"
          aria-label={`${site.name}, ${t('nav.home')}`}
        >
          <span class="inline-block size-2 rounded-full bg-accent animate-pulse" aria-hidden="true"></span>
          <span>{site.terminalLabel}</span>
          <span class="cursor" aria-hidden="true"></span>
        </a>

        <nav aria-label={t('nav.main')} class="hidden md:block">
          <ul class="flex items-center gap-7">
            {nav.map(item => (
              <li>
                <a href={item.href} aria-current={item.active ? 'page' : undefined} class:list={navLink(item.active)}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="flex items-center gap-3">
          <div
            role="group"
            aria-label={t('theme.group')}
            class="hidden items-center rounded border border-hairline bg-raised p-0.5 sm:inline-flex"
          >
            <button
              type="button"
              data-theme-choice="dark"
              class="theme-choice flex items-center gap-1 rounded border border-transparent px-2 py-0.5 font-mono text-[11px] text-muted"
            >
              <Icon name="lucide:moon" class="size-3" aria-hidden="true" />
              {t('theme.noir')}
            </button>
            <button
              type="button"
              data-theme-choice="light"
              class="theme-choice flex items-center gap-1 rounded border border-transparent px-2 py-0.5 font-mono text-[11px] text-muted"
            >
              <Icon name="lucide:sun" class="size-3" aria-hidden="true" />
              {t('theme.paper')}
            </button>
          </div>
          <a
            href={ctas.header.href}
            class="hidden rounded bg-accent px-3.5 py-1.5 font-mono text-xs font-semibold whitespace-nowrap text-on-accent transition-opacity hover:opacity-95 sm:block"
          >
            {ctas.header.label}
          </a>
        </div>
      </div>

      <div class="border-t border-hairline md:hidden">
        <nav aria-label={t('nav.main')} class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-6 py-2.5">
          <ul class="flex gap-5 overflow-x-auto">
            {nav.map(item => (
              <li class="shrink-0">
                <a href={item.href} aria-current={item.active ? 'page' : undefined} class:list={navLink(item.active)}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="flex-grow">
      <slot />
    </main>

    <footer class="border-t border-hairline bg-base">
      <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-6 px-6 py-8 md:flex-row">
        <div class="flex flex-col items-center gap-2 text-center sm:flex-row sm:text-left">
          <span class="font-mono text-sm font-semibold text-fg">{site.terminalLabel}</span>
          <span class="text-xs text-muted">
            © 2026 {site.name} · 网络可观测性评测中心
          </span>
          <span class="text-xs text-muted/70">
            仅作网络测速与学术节点评测 · 客观中立
          </span>
        </div>
        <nav aria-label={t('nav.footer')}>
          <ul class="flex flex-wrap items-center justify-center gap-6 font-mono text-xs tracking-wider text-muted uppercase">
            {nav.map(item => (
              <li>
                <a class="hover:text-fg" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </footer>

    <style>
      .theme-choice[aria-pressed='true'] {
        border-color: var(--color-outline);
        background: var(--color-elevated);
        color: var(--color-accent);
      }
      .theme-choice[aria-pressed='false']:hover {
        color: var(--color-fg);
      }
    </style>

    <script>
      const root = document.documentElement;
      const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]')];
      const render = () => {
        const current = root.dataset.theme === 'light' ? 'light' : 'dark';
        for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.themeChoice === current));
      };
      for (const b of buttons) {
        b.addEventListener('click', () => {
          const next = b.dataset.themeChoice === 'light' ? 'light' : 'dark';
          if (next === 'light') root.dataset.theme = 'light';
          else delete root.dataset.theme;
          try {
            localStorage.setItem('tn-theme', next);
          } catch {}
          render();
        });
      }
      render();
    </script>
  </body>
</html>
