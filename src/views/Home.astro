---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import TerminalMock from '../components/TerminalMock.astro';
import BrandCard from '../components/BrandCard.astro';
import MegaComparisonTable from '../components/MegaComparisonTable.astro';
import DecisionTree from '../components/DecisionTree.astro';
import FaqSection, { homeFaqs } from '../components/FaqSection.astro';
import { brands } from '../data/brands';
import { topics } from '../data/topics';
import { clientPlatforms } from '../data/clients';
import { site } from '../config/site';

const featuredBrands = brands.filter(b => b.featured || (b.rank && b.rank <= 6));

const pageTitle = '机场订阅 - 2026 稳定机场推荐与网络节点实测平台';
const pageDescription = '基于 2026 最新晚高峰（20:30）真机测速与 AI / 流媒体真实解锁矩阵。收录 42 家机场全景横评数据、10秒选型决策树、IPLC/IEPL 专线深度评测与全平台客户端指南。';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: site.name,
      url: site.url,
      description: pageDescription,
      potentialAction: {
        '@type': 'SearchAction',
        target: `${site.url}/brands?search={search_term_string}`,
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: homeFaqs.map(item => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} schema={schema}>
  <!-- 01: Hero Section -->
  <section class="border-b border-hairline bg-base/50 pt-12 pb-16">
    <div class="mx-auto max-w-5xl px-6">
      <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-8">
        <div class="space-y-6 lg:col-span-6 text-center sm:text-left">
          <div class="inline-flex items-center gap-2 rounded-full border border-hairline bg-raised px-3 py-1 font-mono text-xs text-muted">
            <span class="size-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>2026 网络节点可观测性评测中心</span>
          </div>

          <div class="space-y-3">
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-fg leading-tight">
              告别虚标与断联<br />
              <span class="text-accent">找到专属稳定节点</span>
            </h1>
            <p class="text-sm text-muted leading-relaxed max-w-xl">
              剔除套壳水军与过时信息。基于晚高峰（20:30）丢包率压测、物理专线吞吐及 ChatGPT / 4K 流媒体真实解锁矩阵，无虚假承诺，透明对比。
            </p>
          </div>

          <div class="flex flex-wrap items-center justify-center sm:justify-start gap-3 font-mono text-xs">
            <a
              href="#mega-table"
              class="flex items-center gap-2 rounded bg-accent px-5 py-3 font-semibold text-on-accent transition-opacity hover:opacity-90 shadow-lg"
            >
              <span>查看 42 家全景横评大表</span>
              <Icon name="lucide:arrow-down" class="size-4" />
            </a>
            <a
              href="/topics"
              class="flex items-center gap-2 rounded border border-outline bg-raised px-5 py-3 font-medium text-fg transition-colors hover:border-accent hover:text-accent"
            >
              <Icon name="lucide:layers" class="size-4 text-muted" />
              <span>专题选型指南</span>
            </a>
          </div>

          <!-- Trust Badges with CountUp -->
          <div class="grid grid-cols-3 gap-2 border-t border-hairline/60 pt-4 font-mono text-[11px] text-muted text-center">
            <div>
              <div class="font-bold text-fg text-sm flex items-center justify-center">
                <span class="count-up-num" data-target="42">0</span><span>+ 家</span>
              </div>
              <div class="text-[10px] text-muted">全景品牌库</div>
            </div>
            <div>
              <div class="font-bold text-emerald-400 text-sm flex items-center justify-center">
                <span class="count-up-num" data-target="17">0</span><span> 家</span>
              </div>
              <div class="text-[10px] text-muted">官方实测认证</div>
            </div>
            <div>
              <div class="font-bold text-accent text-sm flex items-center justify-center">
                <span class="count-up-num" data-target="100">0</span><span>%</span>
              </div>
              <div class="text-[10px] text-muted">真实证据透明</div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-6">
          <TerminalMock />
        </div>
      </div>
    </div>
  </section>

  <!-- 01.5: Core Category Pillars Hub (Search Intent Architecture) -->
  <section class="border-b border-hairline bg-raised/30 py-10 font-mono">
    <div class="mx-auto max-w-5xl px-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6">
        <div>
          <div class="text-xs text-accent uppercase tracking-wider mb-1 font-semibold">
            // CORE CATEGORIES & KNOWLEDGE BASE
          </div>
          <h2 class="text-xl sm:text-2xl font-bold text-fg">
            全站核心专区与场景选型索引
          </h2>
        </div>
        <span class="text-xs text-muted">
          覆盖 8 大核心搜索意图专区 · 扁平内链直达
        </span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <a
          href="/jichang"
          class="rounded-xl border border-hairline bg-base/70 p-4 hover:border-accent hover:bg-raised/60 transition-all block group shadow-sm"
        >
          <div class="text-sm sm:text-base font-bold text-fg group-hover:text-accent transition-colors flex items-center justify-between">
            <span>机场推荐</span>
            <span class="text-xs text-accent">→</span>
          </div>
          <p class="text-[11px] text-muted mt-1 leading-relaxed">
            晚高峰真机实测排行榜与高性价比专线
          </p>
        </a>

        <a
          href="/tizi"
          class="rounded-xl border border-hairline bg-base/70 p-4 hover:border-accent hover:bg-raised/60 transition-all block group shadow-sm"
        >
          <div class="text-sm sm:text-base font-bold text-fg group-hover:text-accent transition-colors flex items-center justify-between">
            <span>梯子推荐</span>
            <span class="text-xs text-emerald-400">→</span>
          </div>
          <p class="text-[11px] text-muted mt-1 leading-relaxed">
            科学上网防封锁与新手防跑路资金铁律
          </p>
        </a>

        <a
          href="/vpn"
          class="rounded-xl border border-hairline bg-base/70 p-4 hover:border-accent hover:bg-raised/60 transition-all block group shadow-sm"
        >
          <div class="text-sm sm:text-base font-bold text-fg group-hover:text-accent transition-colors flex items-center justify-between">
            <span>VPN 专区</span>
            <span class="text-xs text-cyan-400">→</span>
          </div>
          <p class="text-[11px] text-muted mt-1 leading-relaxed">
            企业加密 VPN 与机场代理底层区别全解析
          </p>
        </a>

        <a
          href="/clash"
          class="rounded-xl border border-hairline bg-base/70 p-4 hover:border-accent hover:bg-raised/60 transition-all block group shadow-sm"
        >
          <div class="text-sm sm:text-base font-bold text-fg group-hover:text-accent transition-colors flex items-center justify-between">
            <span>Clash 教程</span>
            <span class="text-xs text-violet-400">→</span>
          </div>
          <p class="text-[11px] text-muted mt-1 leading-relaxed">
            Clash Verge Rev 客户端安装与订阅导入
          </p>
        </a>

        <a
          href="/nodes"
          class="rounded-xl border border-hairline bg-base/70 p-4 hover:border-accent hover:bg-raised/60 transition-all block group shadow-sm"
        >
          <div class="text-sm sm:text-base font-bold text-fg group-hover:text-accent transition-colors flex items-center justify-between">
            <span>全球节点</span>
            <span class="text-xs text-blue-400">→</span>
          </div>
          <p class="text-[11px] text-muted mt-1 leading-relaxed">
            香港/日本/新加坡/美西双 ISP 住宅 IP 选型
          </p>
        </a>

        <a
          href="/tutorial"
          class="rounded-xl border border-hairline bg-base/70 p-4 hover:border-accent hover:bg-raised/60 transition-all block group shadow-sm"
        >
          <div class="text-sm sm:text-base font-bold text-fg group-hover:text-accent transition-colors flex items-center justify-between">
            <span>使用教程</span>
            <span class="text-xs text-amber-400">→</span>
          </div>
          <p class="text-[11px] text-muted mt-1 leading-relaxed">
            跨平台配置、智能分流与断网报错排查
          </p>
        </a>

        <a
          href="/free"
          class="rounded-xl border border-hairline bg-base/70 p-4 hover:border-accent hover:bg-raised/60 transition-all block group shadow-sm"
        >
          <div class="text-sm sm:text-base font-bold text-fg group-hover:text-accent transition-colors flex items-center justify-between">
            <span>免费资源</span>
            <span class="text-xs text-rose-400">→</span>
          </div>
          <p class="text-[11px] text-muted mt-1 leading-relaxed">
            公共免费节点安全隐患与正规试用替代
          </p>
        </a>

        <a
          href="/brands"
          class="rounded-xl border border-hairline bg-base/70 p-4 hover:border-accent hover:bg-raised/60 transition-all block group shadow-sm"
        >
          <div class="text-sm sm:text-base font-bold text-fg group-hover:text-accent transition-colors flex items-center justify-between">
            <span>品牌评测库</span>
            <span class="text-xs text-emerald-400">→</span>
          </div>
          <p class="text-[11px] text-muted mt-1 leading-relaxed">
            收录 42 家主流品牌实测数据与官方测速截图
          </p>
        </a>
      </div>
    </div>
  </section>

  <!-- 02: Featured Brands Section -->
  <section class="mx-auto max-w-5xl px-6 py-14 font-mono">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <div class="text-xs text-accent uppercase tracking-wider mb-1 font-semibold">
          // TOP RANKINGS
        </div>
        <h2 class="text-2xl font-bold text-fg">
          2026 综合高分推荐榜单
        </h2>
        <p class="text-xs text-muted mt-1">
          根据 2026 最新晚高峰真机测速与综合口碑综合评定（第一主推光速云）
        </p>
      </div>
      <a
        href="/brands"
        class="inline-flex items-center gap-1.5 text-xs text-accent hover:underline font-semibold"
      >
        <span>查看完整品牌库 ({brands.length})</span>
        <Icon name="lucide:arrow-right" class="size-3.5" />
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {featuredBrands.map(brand => (
        <BrandCard brand={brand} />
      ))}
    </div>
  </section>

  <!-- 03: Decision Tree Section -->
  <section class="mx-auto max-w-5xl px-6 py-4">
    <DecisionTree />
  </section>

  <!-- 04: Mega Comparison Table Section -->
  <section id="mega-table" class="mx-auto max-w-5xl px-6 py-8 scroll-mt-14">
    <MegaComparisonTable />
  </section>

  <!-- 05: Topics Grid Section -->
  <section class="border-y border-hairline bg-[#0D1117] py-14 font-mono">
    <div class="mx-auto max-w-5xl px-6">
      <div class="text-center sm:text-left mb-8">
        <div class="text-xs text-cyan-400 uppercase tracking-wider mb-1 font-semibold">
          // TOPIC CLUSTERS
        </div>
        <h2 class="text-2xl font-bold text-fg">
          按场景专题精准选型
        </h2>
        <p class="text-xs text-muted mt-1">
          无论您是预算敏感型学生党、企业跨境外贸、还是大流量重度追剧玩家，都有针对性细分榜单
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {topics.map(topic => (
          <div class="rounded-xl border border-hairline bg-raised/40 p-6 flex flex-col justify-between hover:border-accent/60 transition-colors">
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="rounded bg-accent/20 px-2.5 py-0.5 text-xs font-bold text-accent border border-accent/30">
                  {topic.badge}
                </span>
                <span class="text-xs text-muted">
                  精选 {topic.recommendedBrandSlugs.length} 家
                </span>
              </div>
              <h3 class="text-lg font-bold text-fg mb-1">
                <a href={`/topics/${topic.slug}`} class="hover:text-accent transition-colors">
                  {topic.title}
                </a>
              </h3>
              <p class="text-xs text-emerald-400 font-medium mb-3">
                {topic.subtitle}
              </p>
              <p class="text-xs text-muted line-clamp-2 leading-relaxed">
                {topic.description}
              </p>
            </div>

            <div class="mt-4 pt-3 border-t border-hairline/60 flex items-center justify-between text-xs">
              <span class="text-muted text-[11px]">准则: {topic.criteria[0]}</span>
              <a href={`/topics/${topic.slug}`} class="text-accent hover:underline font-semibold">
                查看榜单 →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 06: Client Platforms Quick Nav -->
  <section class="mx-auto max-w-5xl px-6 py-14 font-mono">
    <div class="text-center sm:text-left mb-8">
      <div class="text-xs text-violet-400 uppercase tracking-wider mb-1 font-semibold">
        // CLIENT ECOSYSTEM
      </div>
      <h2 class="text-2xl font-bold text-fg">
        全平台客户端下载与指引
      </h2>
      <p class="text-xs text-muted mt-1">
        挑选好机场后，搭配官方活跃维护的客户端即可一键畅联
      </p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3 text-center">
      {clientPlatforms.map(os => (
        <a
          href={`/clients#${os.toLowerCase()}`}
          class="rounded-lg border border-hairline bg-raised/50 p-4 transition-all hover:border-accent hover:bg-raised"
        >
          <div class="text-base font-bold text-fg">{os}</div>
          <div class="text-[11px] text-muted mt-1">客户端大全</div>
        </a>
      ))}
    </div>
  </section>

  <!-- 07: Comprehensive FAQ Section -->
  <section class="mx-auto max-w-5xl px-6 py-4">
    <FaqSection />
  </section>

  <!-- 08: Trust Manifesto Box -->
  <section class="mx-auto max-w-5xl px-6 pb-16 font-mono">
    <div class="rounded-xl border border-hairline bg-raised/40 p-8 text-center sm:text-left flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-2 max-w-2xl">
        <div class="text-xs text-emerald-400 font-bold uppercase tracking-wider">
          // 独立网络实验室承诺
        </div>
        <h3 class="text-xl font-bold text-fg">
          坚持客观实测，杜绝虚构与商业买榜
        </h3>
        <p class="text-xs text-muted leading-relaxed">
          所有测速数据均注明测试环境与时间；未实测项目统一标注“待核实”；每个品牌均公开优缺点与退款提示。建议所有新用户优先按月体验。
        </p>
      </div>
      <a
        href="/about"
        class="shrink-0 rounded border border-outline bg-base px-5 py-2.5 text-xs font-semibold text-fg hover:border-accent hover:text-accent transition-colors"
      >
        阅读测速规范与免责声明 →
      </a>
    </div>
  </section>

  <script>
    function initCountUp() {
      const counters = document.querySelectorAll<HTMLElement>('.count-up-num');
      if (!counters.length) return;

      const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const target = parseInt(el.dataset.target || '0', 10);
            const duration = 1000;
            const start = performance.now();

            function update(now: number) {
              const elapsed = now - start;
              const progress = Math.min(elapsed / duration, 1);
              const easeProgress = 1 - (1 - progress) * (1 - progress);
              const current = Math.floor(easeProgress * target);
              el.textContent = String(current);

              if (progress < 1) {
                requestAnimationFrame(update);
              } else {
                el.textContent = String(target);
              }
            }

            requestAnimationFrame(update);
            obs.unobserve(el);
          }
        });
      }, { threshold: 0.1 });

      counters.forEach(c => observer.observe(c));
    }

    initCountUp();
    document.addEventListener('astro:page-load', initCountUp);
  </script>
</Layout>
