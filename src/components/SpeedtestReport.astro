---
import type { SpeedtestNode } from '../data/brands';

interface Props {
  brandName: string;
  testDate: string;
  period: string;
  nodes: SpeedtestNode[];
  avgLatency: string;
  maxDownload: string;
  packetLoss: string;
  dataStatus?: 'measured' | 'vendor' | 'historical';
}

const {
  brandName,
  testDate,
  period,
  nodes,
  avgLatency,
  maxDownload,
  packetLoss,
  dataStatus = 'measured',
} = Astro.props;

// Calculate progress percentage relative to 600 Mbps
function getPercent(downloadStr: string): number {
  const num = parseFloat(downloadStr.replace(/[^0-9.]/g, ''));
  if (isNaN(num)) return 30;
  return Math.min(100, Math.max(10, Math.round((num / 600) * 100)));
}
---

<div class="my-6 rounded-lg border border-hairline bg-[#0D1117] p-5 font-mono text-sm shadow-xl speedtest-report-block">
  <!-- Header -->
  <div class="flex flex-wrap items-center justify-between border-b border-hairline/60 pb-3 gap-2">
    <div class="flex items-center gap-2">
      <span class="inline-block size-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span class="font-bold text-fg tracking-wide">
        🌐 {brandName} 节点测速监控 ({testDate} {period})
      </span>
    </div>
    <div class="flex items-center gap-2 text-xs">
      {dataStatus === 'measured' && (
        <span class="rounded bg-emerald-950/80 px-2 py-0.5 text-emerald-400 border border-emerald-800 flex items-center gap-1 font-semibold">
          <span class="size-1.5 rounded-full bg-emerald-400 animate-ping"></span>
          真机实测
        </span>
      )}
      {dataStatus === 'vendor' && (
        <span class="rounded bg-blue-950/80 px-2 py-0.5 text-blue-400 border border-blue-800 font-semibold">
          ● 官方声明
        </span>
      )}
      {dataStatus === 'historical' && (
        <span class="rounded bg-amber-950/80 px-2 py-0.5 text-amber-400 border border-amber-800 font-semibold">
          ● 历史归档
        </span>
      )}
      <span class="text-muted">单线程 / 多线程综合</span>
    </div>
  </div>

  <!-- Nodes list -->
  <div class="mt-4 space-y-3.5">
    {nodes.map(node => {
      const pct = getPercent(node.download);
      return (
        <div class="group">
          <div class="flex items-center justify-between text-xs mb-1">
            <span class="text-fg flex items-center gap-1.5 font-medium">
              <span class="size-1.5 rounded-full bg-emerald-500"></span>
              {node.region} 节点
            </span>
            <div class="flex items-center gap-4 text-muted">
              <span>延迟: <strong class="text-fg font-bold latency-val">{node.latency}</strong></span>
              <span>带宽: <strong class="text-accent font-bold bw-val">{node.download}</strong></span>
            </div>
          </div>
          <!-- Progress Bar with Dynamic Fill -->
          <div class="h-2 w-full overflow-hidden rounded-full bg-raised">
            <div
              class="h-full rounded-full bg-gradient-to-r from-emerald-500 via-teal-400 to-accent transition-all duration-1000 ease-out speedtest-bar-fill"
              data-target-width={`${pct}%`}
              style="width: 0%"
            ></div>
          </div>
        </div>
      );
    })}
  </div>

  <!-- Footer Summary -->
  <div class="mt-5 flex flex-wrap items-center justify-between border-t border-hairline/60 pt-3 text-xs text-muted gap-2">
    <div class="flex items-center gap-4">
      <span>平均延迟: <strong class="text-fg font-bold">{avgLatency}</strong></span>
      <span>最高吞吐: <strong class="text-accent font-bold">{maxDownload}</strong></span>
      <span>丢包率: <strong class="text-emerald-400 font-bold">{packetLoss}</strong></span>
    </div>
    <span class="text-[11px] text-muted/60">OBSERVATORY_ID: jichangdingyue.blog</span>
  </div>
</div>

<script>
  function animateSpeedtestBars() {
    const reports = document.querySelectorAll('.speedtest-report-block');
    if (!reports.length) return;

    const observer = new IntersectionObserver((entries, obs) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const fills = entry.target.querySelectorAll('.speedtest-bar-fill');
          fills.forEach(bar => {
            const target = (bar as HTMLElement).dataset.targetWidth || '50%';
            (bar as HTMLElement).style.width = target;
          });
          obs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });

    reports.forEach(r => observer.observe(r));
  }

  animateSpeedtestBars();
  document.addEventListener('astro:page-load', animateSpeedtestBars);
</script>
